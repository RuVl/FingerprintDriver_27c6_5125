+/* Bytes 0..5 of the DLL preprocessor's per-frame buffer (cbuf), which
+ * getFeature reads through 0x180052310.  The DLL fills it in 0x180043c70
+ * ({state, purpose, counter, class code, share 0..100, 0}); the port's
+ * preprocessor does not, so this approximation takes byte 0 (peak state) and
+ * byte 3 (class code) from its resolution analysis, byte 4 = 100 and bytes
+ * 1, 2 = 0.  Test harnesses substitute the DLL's bytes. */
+void
+goodix_chicago_feature_preprocessor_context (GoodixChicagoPreprocessor *preprocessor,
+                                             const guint16              raw[GOODIX_CHICAGO_PIXELS],
+                                             guint8                     context[6])
+{
+  g_autofree guint8 *labels = g_new (guint8, GOODIX_CHICAGO_PIXELS);
+  guint peak_state = 0, code = 0;
+  gboolean auxiliary = FALSE;
+
+  memset (context, 0, 6);
+  goodix_chicago_preprocessor_build_resolution_map_full (preprocessor, raw, labels, &peak_state);
+  goodix_chicago_preprocessor_classify_resolution_labels (0x18, labels, GOODIX_CHICAGO_PIXELS,
+                                                         GOODIX_CHICAGO_PIXELS, &code, &auxiliary);
+  context[0] = (guint8) peak_state;
+  context[3] = (guint8) code;
+  context[4] = 100;
+}
