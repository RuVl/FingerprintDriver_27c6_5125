+static void
+efix_relation_metrics (const GoodixChicagoMetricData *new_metric_data,
+                       const GoodixChicagoMetricData *old_metric_data,
+                       const gint32                   transform[6],
+                       gint                          *agreement,
+                       gint                          *coverage)
